-- Example credentials seed. Copy to passwords.sql and fill in real values:
--   cp structure/passwords.sql.example structure/passwords.sql
-- passwords.sql is gitignored; it is the last file installation.sh loads, after
-- agency.sql has seeded placeholder 'username'/'password' rows. Plaintext is
-- fine here: on startup the server encrypts plaintext passwords (enc: prefix)
-- when Auth:CredentialKey is configured.

update Agency set UserName = 'your.email@example.com',	Password = 'CHANGE_ME'	where Title = 'Indeed';
update Agency set UserName = 'your.email@example.com',	Password = 'CHANGE_ME'	where Title = 'IamExpat';
update Agency set UserName = 'your.email@example.com',	Password = 'CHANGE_ME'	where Title = 'LinkedIn';
update Agency set UserName = 'your.email@example.com',	Password = 'CHANGE_ME'	where Title = 'Bayt';
update Agency set UserName = 'your.email@example.com',	Password = 'CHANGE_ME'	where Title = 'Stepstone';
