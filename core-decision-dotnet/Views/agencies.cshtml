@using System.Globalization
@using Photon.JobSeeker
@model AgencyDashboardItem[]
@foreach (var agency in Model)
{
    var index = -1;
    var muted = agency.Seeking || agency.Analyzing ? "" : " text-muted";
    <div class="agency mt-3" aria-title="@agency.Name">
    <div class="agency-head">
        <h4 class="@muted"><a href="@agency.SearchLink">@agency.Name</a></h4>
        <div class="agency-stats-tip" role="tooltip">
            <div class="agency-stats-title">@agency.Name &mdash; @agency.JobCount jobs</div>
            @foreach (var state in Enum.GetValues<JobState>())
            {
                var count = agency.StateCounts.TryGetValue(state, out var c) ? c : 0;
                var pct = agency.JobCount == 0 ? 0 : Math.Round(100.0 * count / agency.JobCount, 1);
                <div class="agency-stats-row">
                    <span class="agency-stats-swatch" style="background-color: var(--@state.CssClass());"></span>
                    <span class="agency-stats-label">@state</span>
                    <span class="agency-stats-num">@count</span>
                    <span class="agency-stats-pct">@pct.ToString("0.#", CultureInfo.InvariantCulture)%</span>
                </div>
            }
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 mb-1" title="Total jobs: @agency.JobCount">
        <div class="agency-job-bar flex-grow-1">
            @if (agency.JobCount == 0)
            {
                <span class="agency-job-bar-empty"></span>
            }
            else
            {
                @foreach (var state in Enum.GetValues<JobState>())
                {
                    var count = agency.StateCounts.TryGetValue(state, out var c) ? c : 0;
                    if (count == 0) continue;
                    var pct = Math.Round(100.0 * count / agency.JobCount, 1).ToString("0.#", CultureInfo.InvariantCulture);
                    <span class="agency-job-bar-seg" style="flex-grow:@count; background-color:var(--@state.CssClass());"
                        title="@state: @count (@pct%)"></span>
                }
            }
        </div>
        <small class="text-body-secondary">@agency.JobCount</small>
    </div>
    @if (agency.Running is int running)
    {
        <div class="d-flex flex-row align-items-center mb-1">
            @if (agency.Methods.Length > 0)
            {
                <div class="form-check form-switch me-3">
                    <input id="SS-@agency.Name" class="form-check-input" type="checkbox" role="switch"
                        checked="@agency.Seeking" onchange="change_status('@agency.Name', 'seeking', this.checked)" />
                    <label class="form-check-label" for="SS-@agency.Name">Search</label>
                </div>
            }
            <div class="form-check form-switch">
                <input id="SA-@agency.Name" class="form-check-input" type="checkbox" role="switch"
                    checked="@agency.Analyzing" onchange="change_status('@agency.Name', 'analyzing', this.checked)" />
                <label class="form-check-label" for="SA-@agency.Name">Analyze</label>
            </div>
        </div>
        @foreach (var method in agency.Methods)
        {
            index += 1;
            var current = index == running ? "btn-success" : "btn-outline-info";
            <button id="RM-@(agency.Name)-@(index)" class="btn @current mt-1"
                onclick="change_running('@agency.Name', @index)">@method.Title</button>
        }
    }
    </div>
}
