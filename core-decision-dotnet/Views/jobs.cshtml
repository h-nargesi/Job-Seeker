@using Photon.JobSeeker
@model List<JobListItem>

@foreach (var info in Model)
{
    <tr id="Job_@info.Job.JobID" onclick="select_job('#Job_@info.Job.JobID')" class="@info.Job.State">
        <td><a href="/job/get/@info.Job.JobID" target="_blank">@info.Job.JobID</a></td>
        <td><span>@info.AgencyName</span></td>
        <td><a href="@info.Job.Link" target="_blank">@info.Job.Title</a></td>
        <td><strong>@info.Job.Score</strong></td>
        <td><span class="@info.Job.State.CssClass()">@info.Job.State</span></td>
        <td><a href="@info.Job.Url" target="_blank">URL</a></td>
        <td><span>@info.Job.Country</span></td>
        <td><span>@info.Job.RegTime</span></td>
        @* <td>
        <button type="button" class="btn btn-link" onclick="logs(@info.Job.JobID)">
        Logs
        </button>
        <div id="logs-body-@info.Job.JobID" class="d-none">@info.Job.Log</div>
        </td> *@
        <td><span class="@info.Relocation.CssClass">@info.Relocation.Text</span></td>
        <td><span class="@info.Remote.CssClass">@info.Remote.Text</span></td>
        <td class="flex-column">
            <a href="#" onclick="apply(@info.Job.JobID)" class="text-success">Applied</a>
            <a href="#" onclick="reject(@info.Job.JobID)" class="text-danger">Rejected</a>
        </td>
    </tr>
}
