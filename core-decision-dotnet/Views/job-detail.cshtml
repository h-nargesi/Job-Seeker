@using System.Text.RegularExpressions
@using Photon.JobSeeker
@model (Job Job, Agency Agency, string Resume)

@{
  Layout = "~/views/layout.cshtml";
  var job = Model.Job;
  var has_content = job.Content != null;
  var SafeToString = (object? value) => value?.ToString() ?? string.Empty;
  var HasValue = (object? value) => SafeToString(value).Length > 0 ? "primary" : "secondary";
  var can_requeue = has_content && job.State is JobState.AIError or JobState.NotApprovedAI;
  var can_promote = job.State is JobState.AiPending or JobState.NotApprovedAI or JobState.AIError;
  var can_force = has_content && job.State is not (JobState.Rejected or JobState.Applied);
  var ai_live = job.AiOptions != null && job.Options?.HumanEdited != true;
  var text_slots = new List<string> { "title", "summary" };
  text_slots.AddRange((job.ResumeText ?? []).Keys.Where(key => key != "title" && key != "summary"));
  var DomId = (string slot) => "slot-" + Regex.Replace(slot, @"[^a-zA-Z0-9-]", "");
}

<div class="container py-4">
  <header class="pb-3 mb-3 border-bottom">
    <a href="/" class="align-items-center text-body-emphasis text-decoration-none">
        <span class="fs-4">@Model.Agency?.Name</span>
    </a>
    <span class="ms-3 me-3" style="font-size: 1.4rem;">|</span>
    <span class="fs-4">@job.Country</span>
  </header>

  <div class="p-5 mb-2 bg-body-tertiary rounded-3">
    <div class="container-fluid py-5">
      <h2 class="display-1">
        <span class="text-secondary">@job.Score</span>
        <span class="text-secondary">/</span>
        <span class="@(job.AiScore == null ? "text-secondary" : "text-info")">@(job.AiScore?.ToString() ?? "—")</span>
        <span class="text-secondary">|</span>
        <span class="@job.State.CssClass()">@job.State</span>
      </h2>
      <h1 class="display-3 fw-bold d-inline-block">@job.Title</h1>
      <h4>Register Time: @job.RegTime</h4>
      <h6>ID: #@job.JobID</h6>
    </div>
  </div>

  <div class="row align-items-md-stretch">
    <div class="col-lg-6 mb-3">
      <div class="h-100 p-5 bg-body-tertiary border rounded-3">
        <h2>Links</h2>
        <a href="@job.Url" class="btn btn-outline-@HasValue(job.Url)" target="_blank">URL</a>
        <a href="@job.Link" class="btn btn-outline-@HasValue(job.Link)" target="_blank">Link</a>
        <h2>Resume</h2>
        <textarea id="job-options" class="codes">@Html.Raw(job.Options?.SimlpeSerialize())</textarea>
        <div>
          <button onclick="submit_options(@job.JobID, 'job-options')" type="button" class="btn btn-outline-primary">Submit</button>
          <a href="/job/resume?jobid=@job.JobID" target="_blank" class="btn btn-outline-primary">Resume as html</a>
          <a href="/job/resume64?jobid=@job.JobID" class="btn btn-outline-secondary">Download Resume as html file</a>
        </div>
        @if (job.AiOptions != null)
        {
          <h2>AI selection</h2>
          <p class="text-body-secondary">@(ai_live ? "Live — the resume renders this selection." : "Diff-only proposal — accepting copies it over your selection.")</p>
          <textarea id="ai-options" class="codes" readonly>@Html.Raw(job.AiOptions.SimlpeSerialize())</textarea>
          <button onclick="accept_ai(@job.JobID)" type="button" class="btn btn-outline-primary">Accept AI selection</button>
        }
        <h2>Resume text</h2>
        @foreach (var slot in text_slots)
        {
          var value = job.ResumeText?.TryGetValue(slot, out var slot_value) == true ? slot_value : null;
          var dom_id = DomId(slot);
          <div class="mb-3">
            <label for="@dom_id" class="form-label">@slot</label>
            @if (slot == "title")
            {
              <input id="@dom_id" type="text" class="codes" value="@value?.Live"
                     onkeydown="if (event.key === 'Enter') text_op(@job.JobID, 'title', 'live', '@dom_id')" />
            }
            else
            {
              <textarea id="@dom_id" class="codes">@Html.Raw(value?.Live)</textarea>
            }
            <button onclick="text_op(@job.JobID, '@slot', 'live', '@dom_id')" type="button" class="btn btn-outline-primary btn-sm">Save live</button>
            @if (value?.Proposal != null && value.Status == ResumeTextSlotStatus.Pending)
            {
              <div class="border rounded p-2 mt-2 bg-body-tertiary">
                <span class="text-body-secondary">Proposal:</span>
                <p style="white-space: break-spaces;">@value.Proposal</p>
                <button onclick="text_op(@job.JobID, '@slot', 'accept', null)" type="button" class="btn btn-outline-success btn-sm">Accept</button>
                <button onclick="text_op(@job.JobID, '@slot', 'reject', null)" type="button" class="btn btn-outline-danger btn-sm">Reject</button>
              </div>
            }
            else if (value?.Status == ResumeTextSlotStatus.Rejected)
            {
              <span class="badge text-bg-secondary">rejected</span>
            }
          </div>
        }
        <h2>Actions</h2>
        <button onclick="apply(@job.JobID)" class="btn btn-outline-success" type="button">Applied</button>
        <button onclick="reject(@job.JobID)" class="btn btn-outline-danger" type="button">Rejected</button>
        @if (can_requeue)
        {
          <button onclick="requeue(@job.JobID)" class="btn btn-outline-warning" type="button">Re-queue AI</button>
        }
        @if (can_force)
        {
          <button onclick="revaluate_job(@job.JobID)" class="btn btn-outline-primary" type="button">Force revaluate</button>
        }
        @if (can_promote)
        {
          <button onclick="promote(@job.JobID)" class="btn btn-outline-info" type="button">Promote</button>
        }
      </div>
    </div>
    <div class="col-lg-6 mb-3">
      <div class="h-100 p-5 text-bg-dark rounded-3">
        <h3>AI extraction</h3>
        <dl class="ai-extract">
          <dt>Verdict</dt><dd>@(job.AiVerdict?.ToString() ?? "—")</dd>
          <dt>AiScore</dt><dd>@(job.AiScore?.ToString() ?? "—")</dd>
          <dt>Seniority</dt><dd>@(job.AiSeniority?.ToString() ?? "—")</dd>
          <dt>Work model</dt><dd>@(job.AiWorkModel?.ToString() ?? "—")</dd>
          <dt>Relocation</dt><dd>@(job.AiRelocation?.ToString() ?? "—")</dd>
          <dt>Contract</dt><dd>@(job.AiContract?.ToString() ?? "—")</dd>
          <dt>Salary</dt>
          <dd>
            @(job.AiSalaryMin?.ToString() ?? "—")–@(job.AiSalaryMax?.ToString() ?? "—")
            @job.AiCurrency @job.AiPeriod
          </dd>
          <dt>Experience</dt><dd>@(job.AiExperienceYears?.ToString() ?? "—")</dd>
          <dt>Skills</dt><dd>@(job.AiSkills == null ? "—" : string.Join(", ", job.AiSkills))</dd>
          <dt>Reason</dt><dd>@(string.IsNullOrEmpty(job.AiReason) ? "—" : job.AiReason)</dd>
        </dl>
        <h3>Logs</h3>
        <p id="logs-body" style="white-space: break-spaces;">@job.Log</p>
        <script>document.addEventListener("DOMContentLoaded", () => display('logs-body'));</script>
      </div>
    </div>
  </div>

  <footer class="pt-3 mt-4 text-body-secondary border-top">
    © 2023
  </footer>
</div>
