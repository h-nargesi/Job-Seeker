@using Photon.JobSeeker
@model StatsPageViewModel

@{
    Layout = "~/views/layout.cshtml";
}

<div class="container py-4">
    <header class="pb-3 mb-3 border-bottom d-flex align-items-center">
        <span class="fs-4">Charts</span>
    </header>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <input id="stats-agency-filter" type="text" class="form-control"
                onkeyup="statsFilterChanged(event)" value="@Model.Agencies" placeholder="Agency Filter" />
        </div>
        <div class="col-md-4">
            <input id="stats-country-filter" type="text" class="form-control"
                onkeyup="statsFilterChanged(event)" value="@Model.Countries" placeholder="Country Filter" />
        </div>
        <div class="col-md-auto">
            <button type="button" class="btn btn-outline-warning" onclick="applyStatsFilters()">Apply</button>
        </div>
    </div>

    <section id="stats-pipeline-row" class="mb-3">
        <div id="stats-charts-body">
            <div class="row g-2 mb-2">
                <div class="col-lg-4">
                    <div class="card card-body py-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="text-body-secondary small">Pipeline funnel (S7)</div>
                            <select id="funnel-agency-select" class="form-select form-select-sm w-auto"></select>
                        </div>
                        <div style="height: 260px;"><canvas id="funnel-chart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card card-body py-2">
                        <div class="text-body-secondary small mb-1">
                            Pipeline health daily (S8) &mdash; AiPending backlog + AIError per day, last 30 days
                        </div>
                        <div style="height: 260px;"><canvas id="pipeline-health-chart"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-12">
                    <div class="card card-body py-2">
                        <div class="text-body-secondary small mb-1">
                            Agency yield (S1) &mdash; AnalyzingRate / AcceptingRate (%), counts in tooltip
                        </div>
                        <div style="height: 260px;"><canvas id="agency-yield-chart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="stats-analysis-row" class="mb-3">
        <div class="row g-2 mb-2">
            <div class="col-12">
                <div class="card card-body py-2">
                    <div class="text-body-secondary small mb-1">
                        Skills gap (S4) &mdash; top 30 demanded skills across analyzed jobs;
                        green = have (resume/keywords), red = missing
                    </div>
                    <div style="height: 520px;"><canvas id="skills-gap-chart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-lg-6">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">
                        Regex score histogram (S2) &mdash; normalized Score, N jobs in caption
                    </div>
                    <div style="height: 220px;"><canvas id="score-regex-chart"></canvas></div>
                    <div class="text-body-secondary small mt-1" id="score-regex-caption">N: 0</div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">
                        AI score histogram (S2) &mdash; AiScore, dashed line marks the passmark bin
                    </div>
                    <div style="height: 220px;"><canvas id="score-ai-chart"></canvas></div>
                    <div class="text-body-secondary small mt-1" id="score-ai-caption">N: 0</div>
                </div>
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-md-6 col-lg-3">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">Work model (S3)</div>
                    <div style="height: 200px;"><canvas id="donut-workModel"></canvas></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">Relocation (S3)</div>
                    <div style="height: 200px;"><canvas id="donut-relocation"></canvas></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">Seniority (S3)</div>
                    <div style="height: 200px;"><canvas id="donut-seniority"></canvas></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">Contract (S3)</div>
                    <div style="height: 200px;"><canvas id="donut-contract"></canvas></div>
                </div>
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-lg-4">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">AiVerdict health (S6) &mdash; all verdict rows</div>
                    <div style="height: 200px;"><canvas id="verdict-chart"></canvas></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">Attention aging (S9) &mdash; backlog age in days</div>
                    <div style="height: 200px;"><canvas id="aging-chart"></canvas></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card card-body py-2 h-100">
                    <div class="text-body-secondary small mb-1">
                        Disposition time (S10) &mdash; Applied/Rejected, days to decide
                    </div>
                    <div style="height: 200px;"><canvas id="disposition-chart"></canvas></div>
                    <div class="text-body-secondary small mt-1" id="disposition-caption">median &mdash; / P90 &mdash;</div>
                </div>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-12">
                <div class="card card-body py-2">
                    <div class="text-body-secondary small mb-1">
                        Competitiveness by experience (S5) &mdash; % AI-passed of AI-evaluated jobs per bucket
                        + avg effective score
                    </div>
                    <div style="height: 260px;"><canvas id="competitiveness-chart"></canvas></div>
                </div>
            </div>
        </div>
    </section>

    <footer class="pt-3 border-top text-body-secondary small">
        S7/S1 follow the Agencies filter; all other charts follow both filters.
    </footer>
</div>

<script src="/scripts/lib/chart.umd.js"></script>
<script src="/scripts/stats-chart.js"></script>
<script src="/scripts/stats-analysis.js"></script>

<script>
    function applyStatsFilters() {
        const agencies = document.getElementById('stats-agency-filter')?.value.trim();
        const countries = document.getElementById('stats-country-filter')?.value.trim();
        const params = new URLSearchParams();

        if (agencies) params.set('agencies', agencies);
        if (countries) params.set('countries', countries);

        const query = params.toString();
        window.location.href = '/report/stats' + (query ? '?' + query : '');
    }

    function statsFilterChanged(event) {
        if (event.code === 'Enter')
            applyStatsFilters();
    }
</script>
