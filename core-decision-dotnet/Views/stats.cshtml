@using Photon.JobSeeker
@model StatsPageViewModel

@{
    Layout = "~/views/layout.cshtml";
}

<div class="container py-4">
    <header class="pb-3 mb-3 border-bottom d-flex align-items-center">
        <span class="fs-4">Charts</span>
    </header>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <input id="stats-agency-filter" type="text" class="form-control"
                onkeyup="statsFilterChanged(event)" value="@Model.Agencies" placeholder="Agency Filter" />
        </div>
        <div class="col-md-4">
            <input id="stats-country-filter" type="text" class="form-control"
                onkeyup="statsFilterChanged(event)" value="@Model.Countries" placeholder="Country Filter" />
        </div>
        <div class="col-md-auto">
            <button type="button" class="btn btn-outline-warning" onclick="applyStatsFilters()">Apply</button>
        </div>
    </div>

    <section id="stats-pipeline-row" class="mb-3">
        <div id="stats-charts-body">
            <div class="row g-2 mb-2">
                <div class="col-lg-4">
                    <div class="card card-body py-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="text-body-secondary small">Pipeline funnel (S7)</div>
                            <select id="funnel-agency-select" class="form-select form-select-sm w-auto"></select>
                        </div>
                        <div style="height: 260px;"><canvas id="funnel-chart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card card-body py-2">
                        <div class="text-body-secondary small mb-1">
                            Pipeline health daily (S8) &mdash; AiPending backlog + AIError per day, last 30 days
                        </div>
                        <div style="height: 260px;"><canvas id="pipeline-health-chart"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-12">
                    <div class="card card-body py-2">
                        <div class="text-body-secondary small mb-1">
                            Agency yield (S1) &mdash; AnalyzingRate / AcceptingRate (%), counts in tooltip
                        </div>
                        <div style="height: 260px;"><canvas id="agency-yield-chart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="stats-analysis-row" class="mb-3">
        <div class="card card-body text-body-secondary small">
            Score histograms (S2), AI donuts (S3), skills gap (S4), competitiveness (S5),
            AiVerdict health (S6), attention aging (S9) and disposition time (S10) land here.
        </div>
    </section>

    <footer class="pt-3 border-top text-body-secondary small">
        S7/S1 follow the Agencies filter; S8 follows both filters. Remaining charts (S2&ndash;S6, S9, S10)
        land in later phases.
    </footer>
</div>

<script src="/scripts/lib/chart.umd.js"></script>
<script src="/scripts/stats-chart.js"></script>

<script>
    function applyStatsFilters() {
        const agencies = document.getElementById('stats-agency-filter')?.value.trim();
        const countries = document.getElementById('stats-country-filter')?.value.trim();
        const params = new URLSearchParams();

        if (agencies) params.set('agencies', agencies);
        if (countries) params.set('countries', countries);

        const query = params.toString();
        window.location.href = '/report/stats' + (query ? '?' + query : '');
    }

    function statsFilterChanged(event) {
        if (event.code === 'Enter')
            applyStatsFilters();
    }
</script>
